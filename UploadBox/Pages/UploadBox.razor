@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using NLog
@using global::UploadBox.Models
@using global::UploadBox.Services
@implements IDisposable

@* Presents the upload file picker and visual drop zone, and raises UploadRequested for selected files. *@
<label class="upload-drop-zone flex-fill @(IsDragOver ? "drag-over" : "")" @ondragenter="HandleDragEnter" @ondragleave="HandleDragLeave" @ondragover:preventDefault @ondrop="HandleDrop">
    <InputFile class="upload-input" OnChange="HandleFileUpload" disabled="@Controller.IsUploading" multiple="@Controller.Options.AllowMultipleFiles" />
    <span class="upload-title">Drop @(Controller.Options.AllowMultipleFiles ? "files" : "a file") here</span>
    <span class="upload-subtitle">or click to browse</span>
</label>

@code {

    private static readonly Logger Logger = LogManager.GetCurrentClassLogger();

    /// <summary>
    /// Gets or sets the callback invoked with the files selected in the picker.
    /// </summary>
    [Parameter]
    public EventCallback<UploadRequest> UploadRequested { get; set; }

    /// <summary>
    /// Gets or sets the controller that supplies upload options and selection state.
    /// </summary>
    [Parameter, EditorRequired]
    public UploadBoxController Controller { get; set; } = null!;

    private bool IsDragOver;

    private int dragCounter;

    /// <summary>
    /// Validates the required controller parameter and subscribes to its state changes.
    /// </summary>
    protected override void OnInitialized()
    {
        if (Controller == null)
        {
            Logger.Error("UploadBox initialized without a required controller parameter");
            throw new InvalidOperationException("UploadBox requires an UploadBoxController parameter.");
        }

        Controller.StateChanged += HandleControllerStateChanged;
    }

    /// <summary>
    /// Marks the drop zone as active while tracking nested drag-enter events.
    /// </summary>
    private void HandleDragEnter(DragEventArgs _)
    {
        dragCounter++;
        IsDragOver = true;
    }

    /// <summary>
    /// Clears the active drop-zone state after the last tracked drag-leave event.
    /// </summary>
    private void HandleDragLeave(DragEventArgs _)
    {
        dragCounter--;

        if (dragCounter <= 0)
        {
            dragCounter = 0;
            IsDragOver = false;
        }
    }

    /// <summary>
    /// Resets drag tracking when a drop event occurs.
    /// </summary>
    private void HandleDrop(DragEventArgs _)
    {
        dragCounter = 0;
        IsDragOver = false;
    }

    /// <summary>
    /// Reports the selected file count to the controller and invokes the upload callback.
    /// </summary>
    /// <param name="e">File-picker change event containing the selected files.</param>
    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        IReadOnlyList<IBrowserFile> files = e.GetMultipleFiles(int.MaxValue);

        Controller.MarkFilesSelected(files.Count);

        try
        {
            await UploadRequested.InvokeAsync(new UploadRequest(files));
        }
        catch (Exception ex)
        {
            Logger.Error(ex, "UploadRequested callback failed for a selection of {SelectedFileCount} files", files.Count);
            throw;
        }
    }

    /// <summary>
    /// Schedules a component render after the controller reports a state change.
    /// </summary>
    /// <param name="sender">The event source.</param>
    /// <param name="e">Event arguments supplied by the controller.</param>
    private void HandleControllerStateChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Removes the controller state-change subscription.
    /// </summary>
    public void Dispose()
    {
        if (Controller is not null)
            Controller.StateChanged -= HandleControllerStateChanged;
    }
}
